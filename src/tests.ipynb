   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "x = np.linspace(1, 50, 100)\n",
    "D = 100\n",
    "area = 3 / 4 *     (D**2 - (D - 2 * x) ** 2, label=\"area\")\n",
    "inercia = 3 / 4 * (D**4 - (D - 2 * x) ** 4, label='inercia')\n",
    "plt.plot(area)\n",
    "plt.plot(inercia)\n"
   ]
  }
